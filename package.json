{
  "name": "hiraku",
  "version": "1.0.1",
  "description": "Aplicativo de transmissão de anime",
  "author": "Hiraku Project",
  "type": "module",
  "main": "desktop/electron.cjs",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "concurrently \"tsx server/index.ts\" \"vite --host\"",
    "dev:server": "tsx server/index.ts",
    "dev:client": "vite --host",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --outfile=dist/index.cjs",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "electron": "concurrently \"tsx server/index.ts\" \"vite --host\" \"cross-env ELECTRON_DEV=1 electron .\"",
    "electron:build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --outfile=dist/index.cjs && electron-builder --win --arm64",
    "electron:build:linux": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --outfile=dist/index.cjs && electron-builder --linux",
    "dist": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --outfile=dist/index.cjs && electron-builder --win --arm64 --linux"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "discord-rpc": "^4.0.1",
    "express": "^4.21.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.453.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af"
}
